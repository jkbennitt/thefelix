# Felix Framework - Docker Ignore File
# Optimize Docker build performance by excluding unnecessary files

# Version control
.git/
.gitignore
.gitattributes
.github/

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
.venv/
.env/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Testing and coverage
.coverage
.pytest_cache/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/
.cache/

# Documentation build
docs/_build/
docs/build/
.readthedocs.yml
*.md
*.rst
docs/

# Development configuration
.env
.env.local
.env.development
.env.test
.env.production
*.local

# Logs and temporary files
logs/
*.log
tmp/
temp/
.tmp/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Node.js (if any frontend assets)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Performance and benchmark data
benchmarks/
metrics/
profiling/
performance-reports/

# Development databases
*.db
*.sqlite
*.sqlite3

# Cache directories
.cache/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Claude Code specific
.claude/

# Large model files (should use Git LFS)
*.bin
*.safetensors
*.h5
*.pkl
models/

# Security sensitive files
*.key
*.pem
*.p12
secrets/
private/

# Backup files
*.bak
*.backup
*.old
*.orig

# Archives
*.zip
*.tar.gz
*.tar.bz2
*.rar
*.7z

# Development tools output
.bandit
.safety
mypy-report/
pylint-report.txt

# Container-specific excludes
Dockerfile*
docker-compose*.yml
.dockerignore

# CI/CD artifacts
.github/
ci/
deploy/
scripts/deploy*

# Felix Framework specific excludes
experiments/failed/
research/drafts/
deprecated/

# Configuration files that should not be in container
config/local/
config/development/
config/*.local.*

# Large datasets and examples
data/raw/
data/processed/
examples/large/

# Terraform and infrastructure
*.tf
*.tfstate
*.tfvars
.terraform/

# Kubernetes
*.yaml
*.yml
k8s/
kubernetes/

# Only include what's needed for runtime